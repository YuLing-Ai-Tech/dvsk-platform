{
  "name": "@yuling-ai-tech/dvsk-platform",
  "version": "0.0.0-private",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:lines": "node scripts/check-line-limits.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/check-line-limits.mjs && tsc -p tsconfig.json --noEmit && eslint . --max-warnings=0 && tsx --test tests/**/*.test.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.0.0"
}
